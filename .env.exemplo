# Local (web): copie para `.env` se quiser
VITE_API_URL=http://localhost:8080

# Desktop local: `.env.desktop` (npm run desktop:dev)
# Produção: `.env.production` (build web + build:release do PDV)

# Release / auto-update (máquina de build):
# RELEASES_URL=https://gaspassapp.com.br/releases/
# TAURI_SIGNING_PRIVATE_KEY_PATH=%USERPROFILE%\.tauri\gaspass-pdv.key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
